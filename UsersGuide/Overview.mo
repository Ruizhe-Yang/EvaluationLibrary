within EvaluationLibrary.UsersGuide;
class Overview "Library scope and model groups"
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>EvaluationLibrary provides signal metrics, response measurements, requirement checks, result comparison and reporting for Modelica simulations. The blocks observe supplied signals and produce numerical results with explicit availability, data status and verdict information.</p><p><code>Signals</code> prepares inputs; <code>Statistics</code>, <code>Response</code>, <code>Requirements</code>, <code>Comparison</code> and <code>Frequency</code> perform evaluations. <code>Results</code> combines and reports results, while <code>Utilities</code> supplies shared types and functions. <code>Examples</code> contains runnable demonstrations.</p></html>"));
end Overview;
