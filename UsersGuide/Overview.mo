within EvaluationLibrary.UsersGuide;
class Overview "Read-only metrics, explicit evidence qualification and structured result reporting."
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>EvaluationLibrary 0.4.0 observes signals and organizes qualified evidence. Its ten first-level packages separate signal operations, statistics, event/response analysis, requirements, comparison, frequency analysis, results and shared utilities. It neither changes a host model nor performs automatic hazard reasoning.</p></html>"));
end Overview;
