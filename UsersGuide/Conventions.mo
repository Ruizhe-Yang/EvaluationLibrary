within EvaluationLibrary.UsersGuide;
class Conventions "Use the units and connection directions declared on each component."
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>Windows are half open. Continuous duration statistics and event inequalities differ from uniform-grid statistics and sampled extrema. Angle wrapping applies only to radian angle differences. DataStatus describes qualification; Verdict describes a requirement decision. No available number or safety pass is inferred from an unavailable numeric placeholder. INVALID dominates witnessed violations in overall interpretation, but the violation witness is retained.</p></html>"));
end Conventions;
