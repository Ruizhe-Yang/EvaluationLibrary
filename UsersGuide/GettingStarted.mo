within EvaluationLibrary.UsersGuide;
class GettingStarted "Load the library and run a first assessment"
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><ol><li>Load Modelica Standard Library 4.0.0, then open the root <code>EvaluationLibrary/package.mo</code>.</li><li>Open <a href=\"modelica://EvaluationLibrary.Examples.MultiSignalAssessment\">Examples.MultiSignalAssessment</a> and run its experiment.</li><li>Inspect <code>assessment.y</code> and the console report. The angle and current channels satisfy their bounds; the ramped position channel exceeds its upper bound.</li><li>For a new model, connect observed signals to <code>Statistics.SignalAssessment.u</code>, configure the channel count, identifiers, units, interpretations and bounds, and set the observation window.</li><li>Connect <code>assessment.y</code> to <code>Results.ConsoleWriter.u</code> with matching array sizes. Enable and connect an optional validity input when the application supplies data-quality information.</li></ol><p>Use <code>Response.EventAssessment</code> for event tasks and <code>Results.CSVWriter</code> or <code>TextWriter</code> for file output. Read each block description before changing its timing or qualification settings.</p></html>"));
end GettingStarted;
